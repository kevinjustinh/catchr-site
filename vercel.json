{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:page(setup|privacy|terms|faq|job-tracker-template|resume-template|gemini-api-key|claude-api-key|openai-api-key|tailor-resume-to-job-description|am-i-qualified-for-this-job|how-catchr-handles-your-data|teal-alternative|simplify-alternative|huntr-alternative|jobscan-alternative|guides).html",
      "destination": "/:page",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:page(setup|privacy|terms|faq|job-tracker-template|resume-template|gemini-api-key|claude-api-key|openai-api-key|tailor-resume-to-job-description|am-i-qualified-for-this-job|how-catchr-handles-your-data|teal-alternative|simplify-alternative|huntr-alternative|jobscan-alternative|guides)",
      "destination": "/:page.html"
    },
    {
      "source": "/get/:item(resume-google|resume-docx|tracker-google|tracker-xlsx)",
      "destination": "/get/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
